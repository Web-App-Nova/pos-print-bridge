{
  "name": "pos-print-bridge",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "WEBAPPNOVA LLP",
  "description": "Local Printer Agent for POS billing — discovers printers, queues jobs, and prints via USB/LAN",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "pos-print-bridge": "build/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "setup:autostart": "node scripts/setup-autostart.mjs",
    "remove:autostart": "node scripts/remove-autostart.mjs",
    "package": "node scripts/package.mjs",
    "package:macos": "node scripts/package.mjs --platform macos",
    "package:windows": "node scripts/package.mjs --platform windows",
    "release": "node scripts/release.mjs",
    "release:macos": "node scripts/release.mjs --platform macos",
    "release:windows": "node scripts/release.mjs --platform windows",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
