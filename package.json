{
  "name": "pos-print-bridge",
  "version": "1.2.0",
  "private": true,
  "description": "Local print bridge for POS billing — discovers LAN printers and sends raw jobs",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "pos-print-bridge": "build/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "setup:autostart": "node scripts/setup-autostart.mjs",
    "remove:autostart": "node scripts/remove-autostart.mjs",
    "package:binaries": "node packaging/build-binaries.mjs",
    "package:binaries:current": "node packaging/build-binaries.mjs --current",
    "package:dmg": "bash packaging/macos/build-dmg.sh",
    "package:win": "npm run package:binaries && echo 'Compile packaging/windows/installer.iss with Inno Setup (iscc)'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@yao-pkg/pkg": "^5.16.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
